# Copy to .env.local for local dev (vercel dev reads this). Never commit .env.local.
# Real secrets for the deployed app live in the Vercel dashboard's Environment Variables, not here.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides — sensible defaults are baked into the code if unset.
# Check the provider's current model list before changing either of these.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ANTHROPIC_CHAT_MODEL=claude-opus-4-8
